      "action": {
        "name": "consultar_sql",
        "args": {
          "consulta": "SELECT substr(fecha, 1, 7) AS mes, ROUND(SUM(cantidad * precio_unitario * (1 - descuento)), 2) AS importe FROM ventas WHERE fecha >= '2025-01-01' AND fecha <= '2025-12-31' GROUP BY mes ORDER BY mes"
        }
      },
