        "args": {
          "consulta": "SELECT ROUND(100.0 * SUM(CASE WHEN c.region = 'Sierra' THEN v.cantidad * v.precio_unitario * (1 - v.descuento) ELSE 0 END) / SUM(v.cantidad * v.precio_unitario * (1 - v.descuento)), 2) AS pct_sierra, ROUND(SUM(CASE WHEN c.region = 'Sierra' THEN v.cantidad * v.precio_unitario * (1 - v.descuento) ELSE 0 END), 2) AS importe_sierra, ROUND(SUM(v.cantidad * v.precio_unitario * (1 - v.descuento)), 2) AS importe_total FROM ventas v JOIN clientes c ON v.cliente_id = c.cliente_id WHERE v.fecha BETWEEN '2025-01-01' AND '2025-12-31'"
