          "consulta": "SELECT\n  SUM(CASE WHEN v.fecha BETWEEN '2025-01-01' AND '2025-06-30' THEN v.cantidad * v.precio_unitario * (1 - v.descuento) ELSE 0 END) AS importe_S1_2025,\n  SUM(CASE WHEN v.fecha BETWEEN '2026-01-01' AND '2026-06-30' THEN v.cantidad * v.precio_unitario * (1 - v.descuento) ELSE 0 END) AS importe_S1_2026\nFROM ventas v\nJOIN productos p ON v.producto_id = p.producto_id\nWHERE p.categoria = 'soporte'"
        }
