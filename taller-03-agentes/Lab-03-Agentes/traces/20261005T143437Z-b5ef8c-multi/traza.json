        "args": {
          "consulta": "SELECT c.nombre, SUM(v.cantidad * v.precio_unitario * (1 - v.descuento)) AS importe_total\nFROM ventas v\nJOIN clientes c ON c.cliente_id = v.cliente_id\nGROUP BY c.cliente_id, c.nombre\nORDER BY importe_total DESC\nLIMIT 1"
        }
