        "args": {
          "consulta": "SELECT SUM(v.cantidad * v.precio_unitario * (1 - v.descuento)) AS ingreso_neto_total, SUM(v.cantidad) AS unidades, SUM(v.cantidad * v.precio_unitario * (1 - v.descuento)) / SUM(v.cantidad) AS ingreso_neto_promedio_por_unidad FROM ventas v JOIN productos p ON v.producto_id = p.producto_id WHERE p.categoria = 'licencia' AND v.fecha BETWEEN '2026-01-01' AND '2026-12-31'"
