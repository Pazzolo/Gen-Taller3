        "args": {
          "consulta": "SELECT p.nombre,\n  SUM(CASE WHEN v.fecha BETWEEN '2025-01-01' AND '2025-06-30' THEN v.cantidad * v.precio_unitario * (1 - v.descuento) ELSE 0 END) AS importe_s1_2025,\n  SUM(CASE WHEN v.fecha BETWEEN '2026-01-01' AND '2026-06-30' THEN v.cantidad * v.precio_unitario * (1 - v.descuento) ELSE 0 END) AS importe_s1_2026,\n  SUM(CASE WHEN v.fecha BETWEEN '2026-01-01' AND '2026-06-30' THEN v.cantidad * v.precio_unitario * (1 - v.descuento) ELSE 0 END) -\n  SUM(CASE WHEN v.fecha BETWEEN '2025-01-01' AND '2025-06-30' THEN v.cantidad * v.precio_unitario * (1 - v.descuento) ELSE 0 END) AS crecimiento\nFROM ventas v\nJOIN productos p ON p.producto_id = v.producto_id\nGROUP BY p.producto_id, p.nombre\nORDER BY crecimiento DESC"
        }
