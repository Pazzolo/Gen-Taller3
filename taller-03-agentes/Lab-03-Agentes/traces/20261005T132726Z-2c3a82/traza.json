        "name": "consultar_sql",
        "args": {
          "consulta": "SELECT p.categoria, SUM(v.cantidad * v.precio_unitario * (1 - v.descuento)) AS facturacion\nFROM ventas v\nJOIN productos p ON p.producto_id = v.producto_id\nWHERE v.fecha BETWEEN '2026-01-01' AND '2026-06-30'\nGROUP BY p.categoria\nORDER BY facturacion DESC"
        }
