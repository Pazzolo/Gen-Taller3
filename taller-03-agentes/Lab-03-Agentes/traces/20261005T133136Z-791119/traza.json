      "action": {
        "name": "consultar_sql",
        "args": {
          "consulta": "SELECT c.region, COUNT(*) AS num_ventas, AVG(v.cantidad * v.precio_unitario * (1 - v.descuento)) AS importe_medio FROM ventas v JOIN clientes c ON v.cliente_id = c.cliente_id WHERE v.fecha LIKE '2026%' GROUP BY c.region ORDER BY importe_medio DESC"
        }
